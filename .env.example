# ============================================================
# Plataforma LHH Colombia - Variables de Entorno (Ejemplo)
# ============================================================
# Copia este archivo como ".env" y ajusta los valores.

# Puerto del servidor (opcional, por defecto 3000)
# PORT=3000

# Contraseña de acceso al Panel del Facilitador.
# Cámbiala antes de cada evento. Mínimo 8 caracteres recomendados.
# Si no se configura, el panel queda ABIERTO (solo para desarrollo local).
FACILITATOR_PASSWORD=tu_contraseña_segura_aqui
